# listn Configuration Template
# Copy this file to .env and customize for your setup
# Usage: cp .env.example .env

# Audio Device ID
# Find your BlackHole device ID using: python main.py --list-devices
# DEVICE_ID=2

# Whisper Model Size
# Options: tiny, base, small, medium, large
# Default: small (good balance of speed and accuracy)
# MODEL_SIZE=small

# Language Code (optional)
# Specifying language is faster than auto-detection
# Examples: en (English), es (Spanish), fr (French), de (German)
# Leave empty for auto-detection
# LANGUAGE=en

# Audio Chunk Duration (seconds)
# How often to transcribe. Smaller = lower latency, larger = better accuracy
# Default: 5.0 seconds
# CHUNK_DURATION=5.0

# Output File Path (optional)
# If set, transcriptions will be saved to this file
# Leave empty for console output only
# OUTPUT_FILE=transcription.txt

# Timestamps
# Include timestamps in output (true/false)
# Default: true
# INCLUDE_TIMESTAMPS=true

# Verbose Mode
# Show detailed Whisper transcription output (true/false)
# Default: false
# VERBOSE=false
